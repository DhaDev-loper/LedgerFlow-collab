DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wrs_accounting
DB_USER=root
DB_PASS=
APP_URL=http://localhost/wrs-accounting-collab

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_here@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here
MAIL_FROM_NAME=LedgerFlow

OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Off-site backups (configure AWS CLI credentials in the Windows backup account)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=ledgerflow
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_SSE=AES256
BACKUP_AWS_PROFILE=

# Optional dedicated user for restore tests; it needs CREATE/DROP DATABASE privileges
BACKUP_RESTORE_DB_USER=
BACKUP_RESTORE_DB_PASS=